{
  "name": "04_approval",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "dispatch-approval",
        "responseMode": "onReceived"
      },
      "name": "Approval Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://localhost:8000/api/v1/dispatches/{{ $json.body.dispatch_id }}/approve",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "decision",
              "value": "={{ $json.body.decision }}"
            },
            {
              "name": "comment",
              "value": "={{ $json.body.comment }}"
            }
          ]
        }
      },
      "name": "Submit Approval to FastAPI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [450, 300]
    },
    {
      "parameters": {
        "workflowId": "05_zoho_project_sync"
      },
      "name": "Trigger Zoho Project Sync",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [650, 300]
    }
  ],
  "connections": {
    "Approval Webhook": {
      "main": [[{"node": "Submit Approval to FastAPI", "type": "main", "index": 0}]]
    },
    "Submit Approval to FastAPI": {
      "main": [[{"node": "Trigger Zoho Project Sync", "type": "main", "index": 0}]]
    }
  }
}
