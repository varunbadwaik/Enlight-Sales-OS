{
  "name": "03_validation_runner",
  "nodes": [
    {
      "parameters": {},
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://localhost:8000/api/v1/dispatches/{{ $json.dispatch_id }}/validate",
        "options": {}
      },
      "name": "Call FastAPI Validator Engine",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [450, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.is_valid }}",
              "value2": true
            }
          ]
        }
      },
      "name": "Is Validation Passed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "workflowId": "09_notification"
      },
      "name": "Notify Pending Approval",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [850, 200]
    },
    {
      "parameters": {
        "workflowId": "08_error_handler"
      },
      "name": "Route to Error Handler / Review",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [850, 400]
    }
  ],
  "connections": {
    "Execute Workflow Trigger": {
      "main": [
        [
          {
            "node": "Call FastAPI Validator Engine",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call FastAPI Validator Engine": {
      "main": [
        [
          {
            "node": "Is Validation Passed?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Validation Passed?": {
      "main": [
        [
          {
            "node": "Notify Pending Approval",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Route to Error Handler / Review",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
