# ==========================================
# Enlight Sales OS — Environment Variables
# ==========================================

# Core Application Config
PROJECT_NAME="Enlight Sales OS"
VERSION="1.0.0"
ENV="production"
LOG_LEVEL="INFO"
SECRET_KEY="replace-with-a-secure-random-secret-key"

# Database Configuration (PostgreSQL / Supabase or SQLite for local)
DATABASE_URL="sqlite+aiosqlite:///./enlight_sales_os.db"
# For Production PostgreSQL / Supabase:
# DATABASE_URL="postgresql+asyncpg://postgres:password@db.supabase.co:5432/postgres"

# Google Gemini 2.5 Flash AI Config
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_TEMPERATURE=0.0
GEMINI_MAX_OUTPUT_TOKENS=2048

# Zoho Books API (.in domain for India Org)
ZOHO_CLIENT_ID="your-zoho-client-id"
ZOHO_CLIENT_SECRET="your-zoho-client-secret"
ZOHO_REFRESH_TOKEN="your-zoho-refresh-token"
ZOHO_ORG_ID="60082578964"
ZOHO_ACCOUNTS_URL="https://accounts.zoho.in"
ZOHO_BOOKS_API_URL="https://www.zohoapis.in/books/v3"

# Twilio WhatsApp Integration Config
WHATSAPP_ACCOUNT_SID="your-twilio-account-sid"
WHATSAPP_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"

# Business Rules & Tolerances
DEFAULT_WEIGHT_TOLERANCE_PERCENT=1.0
SELLING_RATE_LOCK=58.0
