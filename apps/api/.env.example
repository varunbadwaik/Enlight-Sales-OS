# Application Config
PROJECT_NAME="Invoice Automation API"
VERSION="1.0.0"
ENV="development"
LOG_LEVEL="INFO"

# Database Config (PostgreSQL / Supabase)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/invoice_automation"

# AWS S3 Storage Config
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_REGION="us-east-1"
AWS_S3_BUCKET_NAME="invoice-automation-documents"

# Google Gemini AI Config
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-1.5-pro"
GEMINI_TEMPERATURE=0.0
GEMINI_MAX_OUTPUT_TOKENS=2048

# Business Rule Tolerances
DEFAULT_WEIGHT_TOLERANCE_PERCENT=1.0

# Zoho Books API Config
ZOHO_CLIENT_ID="your-zoho-client-id"
ZOHO_CLIENT_SECRET="your-zoho-client-secret"
ZOHO_REFRESH_TOKEN="your-zoho-refresh-token"
ZOHO_ORGANIZATION_ID="your-zoho-org-id"
ZOHO_ACCOUNTS_URL="https://accounts.zoho.com"
ZOHO_BOOKS_API_URL="https://www.zohoapis.com/books/v3"
